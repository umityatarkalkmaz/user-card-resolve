[Unit]
Description=Uye Karti static site
After=network.target

[Service]
EnvironmentFile=/opt/uye-karti/.env
ExecStart=/usr/bin/python3 -m http.server ${PORT} --directory /opt/uye-karti/site
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
